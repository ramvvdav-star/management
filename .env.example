# eSecurityIn Environment Variables

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Supabase Database Integration:
# If provided, eSecurityIn connects directly to your Supabase PostgreSQL database.
# If omitted, eSecurityIn uses its built-in centralized server database with disk persistence.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
